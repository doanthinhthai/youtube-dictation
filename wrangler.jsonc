{
  "name": "youtube-dictation",
  "main": "worker/auth.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/auth/*"]
  },
  "vars": {
    "SUPABASE_URL": "https://fejklynoerubxjohijyy.supabase.co"
  },
  "ratelimits": [
    {
      "name": "USERNAME_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 12, "period": 60 }
    },
    {
      "name": "USERNAME_IP_LIMIT",
      "namespace_id": "1002",
      "simple": { "limit": 90, "period": 60 }
    }
  ]
}
